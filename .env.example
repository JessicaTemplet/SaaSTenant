# Copy this file to .env and fill it in before running `docker compose up`.
# .env is gitignored — never commit real secrets here.

# Required. Rails needs this to boot at all (session/cookie signing, etc.)
# regardless of whether you ever touch encrypted credentials. Generate one
# with: bin/rails secret
SECRET_KEY_BASE=

# Optional. Only needed if you want Rails.application.credentials to decrypt
# for real (e.g. the LemonSqueezy webhook secret in config/credentials.yml.enc).
# Without it the app still boots fine — anything reading credentials just sees
# nil, which the webhook controller already treats as "reject the request."
# Value is the contents of config/master.key.
RAILS_MASTER_KEY=

# Postgres credentials for the primary database — the "app" service and the
# "db" service both read these, so they only need to be set once here.
POSTGRES_USER=saas_tenant
POSTGRES_PASSWORD=change_me
