# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
#
# When deploying with destinations, shared secrets can go in .kamal/secrets-common and
# destination-specific secrets in .kamal/secrets.<destination>. This .kamal/secrets file is used
# only when no destination is selected.

# All five of these need to be set in whatever shell runs `bin/kamal deploy`
# (a .env file in this directory works, or export them in CI). None of them
# are literal values here, so this file itself stays safe to commit.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$(cat config/master.key 2>/dev/null || echo "$RAILS_MASTER_KEY")
SECRET_KEY_BASE=$SECRET_KEY_BASE
SAAS_TENANT_DATABASE_PASSWORD=$SAAS_TENANT_DATABASE_PASSWORD
POSTGRES_PASSWORD=$SAAS_TENANT_DATABASE_PASSWORD # accessories/db and env/clear.SAAS_TENANT_DATABASE_USERNAME must point at the same Postgres role/password
